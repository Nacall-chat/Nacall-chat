# Copie para .env.local. Nunca envie valores reais ao Git.
# Local (Development) usa os serviços de homologação; nunca os de produção.
# Na Vercel: Production = branch main; Preview da branch release = homologação.

# Supabase (Settings → API). Públicas: vão para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Supabase, somente servidor. Nunca use prefixo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVER_SECRET_OR_SERVICE_ROLE_KEY

# LiveKit (Settings → Keys), somente servidor.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Opcional, só para scripts/integration-smoke.mjs e scripts/groups-smoke.mjs.
# NACALL_TEST_URL=http://localhost:3002
