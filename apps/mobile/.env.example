# Copie para .env.local (não vai para o Git). Só valores PÚBLICOS: tudo com EXPO_PUBLIC_ aparece em texto puro no app.
# Aponte para a HOMOLOGAÇÃO. Nunca use chaves de serviço, LiveKit ou Asaas aqui.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# URL base das rotas /api (ex.: https://nacall-hml.vercel.app), sem barra no final.
EXPO_PUBLIC_API_URL=
